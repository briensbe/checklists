    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@lucide/angular": "^1.59.0",
    "dexie": "^4.4.6",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "angular-cli-ghpages": "^3.1.2",
